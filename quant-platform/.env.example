# Copy this file to `.env` (same folder) and fill in real values.
#   cp .env.example .env   then edit .env
# The compare server auto-loads .env on startup, so the keys survive
# console/SSH reconnects — no need to `export` them every time.
# The real `.env` is gitignored and never committed.

# Alpaca paper trading keys (IEX feed) — https://alpaca.markets
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Polygon key (deeper history + premarket) — https://polygon.io
POLYGON_API_KEY=
