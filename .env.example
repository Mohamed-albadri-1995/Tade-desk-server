# Copy to .env and fill in.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Base URL of the screener tool (the trading tool reads
# SCREENER_URL/api/registry/today and embeds the UI in the Screener tab)
SCREENER_URL=http://13.62.52.6:3000
SECRET_KEY=change-me-to-a-long-random-string

# The VERIFIED qp library is vendored in this repo at quant-platform/ and
# loaded automatically — QP_PATH is only needed to point elsewhere (e.g. a
# shared screener checkout). Leave unset to use the vendored copy.
# QP_PATH=/home/ec2-user/Tade-desk-server/quant-platform

# Optional
POLYGON_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./trade_desk.db
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
