# Copy to .env and fill in.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Base URL of the screener tool (the trading tool reads
# SCREENER_URL/api/registry/today and embeds the UI in the Screener tab)
SCREENER_URL=http://13.62.52.6:3000
SECRET_KEY=change-me-to-a-long-random-string

# VERIFIED qp library source.
#   - Unset (default): use the copy vendored in this repo (quant-platform/).
#     Pinned — updates only when you re-sync. Best for live trading.
#   - Set to a shared checkout: REFERENCE mode — that library is used
#     directly, so changes there reflect here after a restart. Best while
#     you're still developing the library / charting tool. A broken library
#     then stops the tool (it refuses to trade on unverified math) rather
#     than falling back to a stale copy.
# QP_PATH=/home/ec2-user/screener/quant-platform

# Optional
POLYGON_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./trade_desk.db
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
